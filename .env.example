# Copy this file to .env and fill in the values
# .env is gitignored — never commit credentials

# ─── Databricks workspace ──────────────────────────────────────────
# The host URL of your Databricks workspace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# Optional: a personal access token for local CLI runs
# In production, on-behalf-of-user auth handles this automatically
DATABRICKS_TOKEN=

# ─── SQL Warehouse ─────────────────────────────────────────────────
# The Statement Execution API runs UC functions against this warehouse.
# Find the ID in the SQL Warehouse UI under "Connection details".
WAREHOUSE_ID=

# ─── Genie space ───────────────────────────────────────────────────
# The space ID from the Genie URL
GENIE_SPACE_ID=01ef0000-0000-0000-0000-000000000000

# ─── Vector Search ─────────────────────────────────────────────────
VECTOR_SEARCH_ENDPOINT=customer_ops_endpoint
VECTOR_SEARCH_INDEX=comment_index_vs

# ─── LLM endpoint ──────────────────────────────────────────────────
LLM_ENDPOINT=databricks-claude-sonnet-4-5

# ─── Unity Catalog ─────────────────────────────────────────────────
WORKING_CATALOG=main
WORKING_SCHEMA=sales_ops

# ─── MLflow experiment ─────────────────────────────────────────────
MLFLOW_EXPERIMENT=/Shared/sales_ops_agent
